# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/angelus
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Studio served when the request's host name matches no studio domain (local dev, single-studio installs)
DEFAULT_TENANT_SLUG=angelus
# Folder for private client photos (default: ./private-media). Never inside public/.
# PRIVATE_MEDIA_DIR=/var/lib/angelus/private-media
# Set to false to stop this process running background jobs (e.g. extra app instances)
# PAYLOAD_JOBS_AUTORUN=false
# Online deposits (Stripe). Leave empty to keep payment off; the quote page then says so.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
