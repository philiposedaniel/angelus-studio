# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/angelus
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Studio served when the request's host name matches no studio domain (local dev, single-studio installs)
DEFAULT_TENANT_SLUG=angelus
# Folder for private client photos (default: ./private-media). Never inside public/.
# PRIVATE_MEDIA_DIR=/var/lib/angelus/private-media
# Set to false to stop this process running background jobs (e.g. extra app instances)
# PAYLOAD_JOBS_AUTORUN=false
# Online deposits (Stripe). Leave empty to keep payment off; the quote page then says so.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Email through any SMTP service (Resend, Postmark, SES...). Leave SMTP_HOST empty to send nothing.
# EMAIL_MODE=log writes each email to the log instead of sending it (development only).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM_ADDRESS=events@your-domain.com
# EMAIL_FROM_NAME=Angelus Media Productions
# Private object storage for client photos (Cloudflare R2, Amazon S3, MinIO). Leave S3_BUCKET empty to keep photos on local disk.
# A bucket set without its region and keys makes each photo upload fail, rather than keeping files locally.
# S3_BUCKET=studio-private
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
